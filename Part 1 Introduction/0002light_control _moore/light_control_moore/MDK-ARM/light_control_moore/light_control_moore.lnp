--cpu Cortex-M3
"light_control_mealy\startup_stm32f103xb.o"
"light_control_mealy\main.o"
"light_control_mealy\stm32f1xx_it.o"
"light_control_mealy\stm32f1xx_hal_msp.o"
"light_control_mealy\stm32f1xx_hal_gpio_ex.o"
"light_control_mealy\stm32f1xx_hal_tim.o"
"light_control_mealy\stm32f1xx_hal_tim_ex.o"
"light_control_mealy\stm32f1xx_hal.o"
"light_control_mealy\stm32f1xx_hal_rcc.o"
"light_control_mealy\stm32f1xx_hal_rcc_ex.o"
"light_control_mealy\stm32f1xx_hal_gpio.o"
"light_control_mealy\stm32f1xx_hal_dma.o"
"light_control_mealy\stm32f1xx_hal_cortex.o"
"light_control_mealy\stm32f1xx_hal_pwr.o"
"light_control_mealy\stm32f1xx_hal_flash.o"
