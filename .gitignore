*.crf
*.elf
*.axf
*.hex
*.bin
*.map
*.out
*.lst
*.htm
*.build_log.htm
*.dep

# ==========================================================
# 2. IAR Embedded Workbench (EWARM)
# ==========================================================
# Ignore entire output folders (covers STM32CubeMX project-named folders)
**/Obj/
**/List/
**/Exe/
**/BrowseInfo/
**/Debug/
**/Release/
**/settings/

# IAR temporary, backup & static analysis files
*.ewt
*.dni
*.wsdt
*.wspos
*.crun
*.dbgdt
*.cspy
*.cspy.*
*.pbi
*.pbd
*.pbw
*.ninja*
Backup*

# ==========================================================
# 3. Keil uVision (MDK-ARM)
# ==========================================================
# Ignore Keil output directories anywhere in the repo
**/Listings/
**/Objects/

# User-specific uVision session files (Keep ONLY *.uvprojx and *.uvmpw)
*.opt
*.uvopt
*.uvoptx
*.uvgui
*.uvgui.*
*.uvguix
*.uvguix.*

# Keil intermediate & debugger files
*.cod
*.i
*.m51
*.m66
*.scr
*.b[0-3][0-9]
*.h86
*.sbr
*._ia
*.__i
*._ii
*.cdb
*.ic
*.lin
*.lnp
*.orc
*.pack
*.plg
*.sfd
*.sfr
