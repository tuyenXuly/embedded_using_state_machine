<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.1" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="HSMs" stereotype="0x02">
  <class name="Clock_Alarm" superclass="qpc::QHsm">
   <attribute name="curr_time" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="temp_time" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="alarm_time" type="uint32_t" visibility="0x02" properties="0x00"/>
   <attribute name="time_mode" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="time_status" type="uint8_t" visibility="0x02" properties="0x00"/>
   <attribute name="obj" type="Clock_Alarm" visibility="0x02" properties="0x01"/>
   <statechart properties="0x00">
    <initial target="../1/2">
     <initial_glyph conn="3,11,5,3,4,11,8">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Clock">
     <history type="deep" target="../2">
      <history_glyph conn="10,56,3,2,10,-16"/>
     </history>
     <tran trig="ALARM" target="../../2">
      <tran_glyph conn="79,78,2,0,17">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="Ticking">
      <tran trig="SET" target="../../3/2">
       <tran_glyph conn="47,25,1,3,29">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="OK" target="../../3/3">
       <tran_glyph conn="47,32,1,3,10,27,19">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="15,11,32,29"/>
     </state>
     <state name="Settings">
      <tran trig="ABRT" target="../../2">
       <tran_glyph conn="64,65,3,2,-32,-25">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <tran trig="OK" target="../../2">
       <tran_glyph conn="64,70,3,2,-38,-30">
        <action box="0,-2,10,2"/>
       </tran_glyph>
      </tran>
      <state name="Clock_Setting">
       <state_glyph node="76,13,28,29"/>
      </state>
      <state name="Alarm_Setting">
       <state_glyph node="76,45,28,29"/>
      </state>
      <state_glyph node="64,8,52,67"/>
     </state>
     <state_glyph node="10,1,109,77"/>
    </state>
    <state name="Alarm_Notify">
     <tran trig="OK" target="../../1" cpref="../../1/0">
      <tran_glyph conn="67,103,3,3,-60,-47,2">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="67,95,29,24"/>
    </state>
    <state_diagram size="135,182"/>
   </statechart>
  </class>
  <directory name=".">
   <file name="ClockAlarm_SM.c">
    <text>#include &quot;qpc.h&quot;             // QP/C framework
#include &quot;ClockAlarm_SM.h&quot;      // this application

$declare${HSMs::Clock_Alarm}
$define${HSMs::Clock_Alarm_ctor}
$define${HSMs::Clock_Alarm}</text>
   </file>
   <file name="ClockAlarm_SM.h">
    <text>#ifndef __CLOCK_ALARM_H__
#define __CLOCK_ALARM_H__

enum ClockAlarm_Signals{
    SET_SIG = Q_USER_SIG,
    OK_SIG,
    ABRT_SIG,
    ALARM_SIG,
    TICK_SIG,
    MAX_SIG
};

$declare${HSMs::Clock_Alarm_ctor}
#endif</text>
   </file>
  </directory>
  <operation name="Clock_Alarm_ctor" type="void" visibility="0x00" properties="0x00">
   <code>QHsm_ctor(&amp;Clock_Alarm_obj.super, Q_STATE_CAST(&amp;Clock_Alarm_initial));</code>
  </operation>
 </package>
</model>
